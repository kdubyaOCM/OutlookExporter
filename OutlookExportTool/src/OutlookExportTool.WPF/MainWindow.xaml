<Window x:Class="OutlookExportTool.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Outlook Export Tool" Height="420" Width="760" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0 0 10 10" VerticalAlignment="Center" Text="Outlook Folder"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0 0 10 10" IsReadOnly="True" Text="{Binding OutlookFolderPath}" />
        <Button Grid.Row="0" Grid.Column="2" Margin="0 0 0 10" Width="150" Height="28" Content="Select Outlook Folder" Command="{Binding PickOutlookFolderCommand}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0 0 10 10" VerticalAlignment="Center" Text="Output Folder"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0 0 10 10" IsReadOnly="True" Text="{Binding OutputFolder}" />
        <Button Grid.Row="1" Grid.Column="2" Margin="0 0 0 10" Width="150" Height="28" Content="Select Output Folder" Command="{Binding PickOutputFolderCommand}"/>

        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0 0 0 10">
            <Button Width="120" Height="32" Margin="0 0 10 0" Content="Start" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"/>
            <Button Width="120" Height="32" Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}"/>
        </StackPanel>

        <ProgressBar Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Height="18" Margin="0 0 0 10" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" TextWrapping="Wrap" Text="{Binding StatusText}"/>
    </Grid>
</Window>
